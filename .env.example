# ── Camera source ──────────────────────────────────────────────────
# "usb"  — Direct USB/CSI camera via PyAV (V4L2 on Linux, DShow on Windows)
# "rtsp" — RTSP/IP camera via OpenCV FFmpeg backend
CAMERA_SOURCE=usb

# Required only when CAMERA_SOURCE=rtsp:
CAMERA_SOURCE_URL=

# ── Signaling method ──────────────────────────────────────────────
# "commands"   — Anedya Commands (zstd-compressed SDP, lifecycle tracking)
# "valuestore" — Anedya Value Store (offer_<id> / answer_<id>)
SIGNALING_METHOD=commands

# ── Anedya credentials ────────────────────────────────────────────
ANEDYA_DEVICE_ID=your-device-id
ANEDYA_CONNECTION_KEY=your-device-connection-key
ANEDYA_REGION=ap-in-1

# ── Recording ─────────────────────────────────────────────────────
RECORDING_SEGMENT_SECONDS=5
RECORDING_MIN_FREE_MB=512
RECORDING_RETENTION_DAYS=7
RECORDING_RETENTION_HOURS=0
RECORDING_RETENTION_SECONDS=
